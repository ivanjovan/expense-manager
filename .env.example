# Copy this file to .env and adjust as needed.
# `docker compose up -d` provisions a database matching these defaults.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://expense:expense_dev_password@localhost:5432/expense_manager?schema=public"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-random-32-byte-value"
AUTH_URL="http://localhost:3000"

# When true, /register is open to anyone. Should stay false once the
# household's first (owner) account has been created — see SRS §6.2.
# The app also auto-opens registration when zero users exist, regardless
# of this flag, so the very first run always works.
ALLOW_PUBLIC_REGISTRATION="false"

# --- Email (optional) --------------------------------------------------------
# If unset, invitation links and password resets are shown on-screen to the
# household owner to share manually instead of being emailed (SRS §6.2).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Expense Manager <no-reply@example.com>"

# --- Document scanning (optional) --------------------------------------------
# Scans a photographed fuel receipt or electricity bill and pre-fills the
# entry form. Entirely optional: with no provider configured the scan
# buttons are hidden and everything else works unchanged.
#
#   claude — real extraction. Needs an Anthropic API key from
#            console.anthropic.com (billed separately from a Claude Pro
#            subscription, which does NOT include API access).
#   mock   — fixture data, no key and no cost. For development only: it
#            invents plausible values, and the review screen labels every
#            result it produces as sample data.
DOCUMENT_EXTRACTION_PROVIDER="mock"
# DOCUMENT_EXTRACTION_API_KEY="sk-ant-..."

# --- Migrations (production only) ---------------------------------------------
# Prisma's `migrate deploy` takes a session-scoped advisory lock, which is
# unreliable through a transaction pooler (Neon's "-pooler" host) and shows
# up as an intermittent P1002 lock timeout during deploys.
#
# Set this to the SAME Neon connection string as DATABASE_URL but with the
# direct host — i.e. drop "-pooler" from the hostname:
#   pooled:  ...@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/neondb
#   direct:  ...@ep-cool-name-123456.eu-central-1.aws.neon.tech/neondb
#
# Migrations only. The app keeps using the pooled DATABASE_URL at runtime,
# which is what you want for serverless. Unset locally — it falls back to
# DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://..."
