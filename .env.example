# Copy this file to .env and adjust as needed.
# `docker compose up -d` provisions a database matching these defaults.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://expense:expense_dev_password@localhost:5432/expense_manager?schema=public"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-random-32-byte-value"
AUTH_URL="http://localhost:3000"

# When true, /register is open to anyone. Should stay false once the
# household's first (owner) account has been created — see SRS §6.2.
# The app also auto-opens registration when zero users exist, regardless
# of this flag, so the very first run always works.
ALLOW_PUBLIC_REGISTRATION="false"

# --- Email (optional) --------------------------------------------------------
# If unset, invitation links and password resets are shown on-screen to the
# household owner to share manually instead of being emailed (SRS §6.2).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Expense Manager <no-reply@example.com>"
