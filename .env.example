# Copy this file to .env and adjust as needed.
# `docker compose up -d` provisions a database matching these defaults.

# --- Database ---------------------------------------------------------------
DATABASE_URL="postgresql://expense:expense_dev_password@localhost:5432/expense_manager?schema=public"

# --- Auth.js ------------------------------------------------------------------
# Generate with: npx auth secret
AUTH_SECRET="change-me-to-a-random-32-byte-value"
AUTH_URL="http://localhost:3000"

# When true, /register is open to anyone. Should stay false once the
# household's first (owner) account has been created — see SRS §6.2.
# The app also auto-opens registration when zero users exist, regardless
# of this flag, so the very first run always works.
ALLOW_PUBLIC_REGISTRATION="false"

# --- Email (optional) --------------------------------------------------------
# If unset, invitation links and password resets are shown on-screen to the
# household owner to share manually instead of being emailed (SRS §6.2).
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM="Expense Manager <no-reply@example.com>"

# --- Document scanning (optional) --------------------------------------------
# Scans a photographed fuel receipt or electricity bill and pre-fills the
# entry form. Entirely optional: with no provider configured the scan
# buttons are hidden and everything else works unchanged.
#
#   gemini — Google Gemini. Free tier available at aistudio.google.com.
#   claude — Anthropic. Needs a key from console.anthropic.com (billed
#            separately from a Claude Pro subscription, which does NOT
#            include API access).
#   mock   — fixture data, no key and no cost. Development only: it invents
#            plausible values, and the review screen labels every result it
#            produces as sample data.
#
# NOTE on Gemini's free tier: Google uses free-tier requests to improve
# their products, including human review. Your bills carry a name, address
# and account number. The paid tier does not do this and costs roughly
# $0.0004 per scan — about 5 cents a year at household volume. Verify the
# current terms before deciding; this is a real trade, not a formality.
DOCUMENT_EXTRACTION_PROVIDER="mock"

# The key for the selected provider. For Gemini you may instead set
# GOOGLE_GENERATIVE_AI_API_KEY (Google's conventional name) — the Gemini
# provider accepts either, and this one wins if both are present.
# DOCUMENT_EXTRACTION_API_KEY="..."
# GOOGLE_GENERATIVE_AI_API_KEY="..."

# Overrides the provider's default model. Model IDs get retired on a
# schedule this repo can't track — gemini-2.5-flash started returning
# "no longer available to new users" and took the scan feature down with
# it — so this is an env change rather than a deploy.
#
# Gemini defaults to gemini-3.6-flash, chosen by measuring candidates
# against a fuel receipt: it read every field correctly where
# gemini-3.5-flash silently omitted the price and litres.
#
# Set "gemini-flash-latest" to track Google's current flash automatically
# and never hit a retirement again, accepting that the model can change
# under you without notice. List what your key can actually use with:
#   curl -s "https://generativelanguage.googleapis.com/v1beta/models?key=$KEY"
# DOCUMENT_EXTRACTION_MODEL="gemini-3.6-flash"

# --- Migrations (production only) ---------------------------------------------
# Prisma's `migrate deploy` takes a session-scoped advisory lock, which is
# unreliable through a transaction pooler (Neon's "-pooler" host) and shows
# up as an intermittent P1002 lock timeout during deploys.
#
# Set this to the SAME Neon connection string as DATABASE_URL but with the
# direct host — i.e. drop "-pooler" from the hostname:
#   pooled:  ...@ep-cool-name-123456-pooler.eu-central-1.aws.neon.tech/neondb
#   direct:  ...@ep-cool-name-123456.eu-central-1.aws.neon.tech/neondb
#
# Migrations only. The app keeps using the pooled DATABASE_URL at runtime,
# which is what you want for serverless. Unset locally — it falls back to
# DATABASE_URL.
# DIRECT_DATABASE_URL="postgresql://..."
